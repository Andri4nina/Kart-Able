{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kart Able",
  "version": "0.3.0",
  "identifier": "io.github.andri4nina.kartable",
  "build": {
    "beforeBuildCommand": "npm --prefix ../smkw-ui run build",
    "frontendDist": "../smkw-ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Rasoamanana Andrianina",
    "copyright": "Rasoamanana Andrianina",
    "category": "Game",
    "shortDescription": "Course de karts 3D multijoueur",
    "longDescription": "Kart Able, le jeu de course de karts 3D de Rasoamanana Andrianina. L'application heberge les parties en reseau local : les autres joueurs rejoignent depuis leur application ou leur navigateur.",
    "resources": {
      "../smkw-ui/dist/": "web/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
